{
  "name": "ruferson-github-io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest --project=unit",
    "test:run": "vitest run --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "test:all": "vitest run",
    "coverage": "vitest run --project=unit --coverage",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "storybook": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "latest"
  }
}
